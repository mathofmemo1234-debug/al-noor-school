rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read for classes so new students can select a class during signup
    match /classes/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Secure all other documents: require authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
